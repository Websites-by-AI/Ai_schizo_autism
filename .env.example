# Copy to .env for local development. Never commit real secrets.
# On Hugging Face Spaces put secrets in Settings > Variables and secrets.
PORT=7860

# Secret: fine-grained token with Inference Providers permission.
HF_TOKEN=
# Variable: choose a currently supported chat-completion model in the HF Playground.
HF_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
HF_MAX_TOKENS=800
HF_TIMEOUT_MS=45000

# Secret: obtain from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=
# Optional variable; getMe discovers the authoritative username when polling starts.
TELEGRAM_BOT_USERNAME=
# Optional secret: start your bot and send /id to get the numeric chat ID.
# Required only for contact-form notifications, not AI chat.
TELEGRAM_ADMIN_CHAT_ID=
# Leave unset to automatically enable polling when a token is present.
# Set false if this token is used by another worker, or for notifications only.
# TELEGRAM_POLLING_ENABLED=true
# Recommended during private testing. Empty means any user may talk to the bot.
TELEGRAM_ALLOWED_USER_IDS=

# Optional secret: protect website AI requests from public use/credit spending.
# Visitors enter this shared key in the chat UI; never use HF_TOKEN or the bot token here.
WEB_ACCESS_TOKEN=
WEB_REQUESTS_PER_MINUTE=8
AI_GLOBAL_REQUESTS_PER_MINUTE=30
AI_MAX_CONCURRENT=4

# Set true ONLY behind a trusted reverse proxy (e.g. Spaces) that controls X-Forwarded-For.
TRUST_PROXY=false
# Exact additional origins, separated by commas; no trailing slash.
# Native Pages API uses these for restricted CORS (e.g. the static Space app host).
# Optional Node mode uses these only for its POST origin check, not CORS.
ALLOWED_ORIGINS=

# Optional secret: use the same random value in Pages and the Space.
# Authenticates Cloudflare's client-IP forwarding; never use an account/API token here.
PROXY_SHARED_SECRET=

# Public build-time URL, not a secret. Needed only for a static Space calling Pages.
# VITE_API_BASE_URL=https://YOUR_PROJECT.pages.dev
